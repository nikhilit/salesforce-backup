                        <th style="background-color:black; color:white; width:50%;">
                           Any Remarks (Optional)
                           </th>
                           <th style="Width:50%;">Customer's Signature is Compulsory</th>
                           </tr>
                           </table>  -->

                  

        
      
    </div>
</apex:page>