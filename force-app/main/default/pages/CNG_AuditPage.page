   <script>
      function toggleAccordionCompressor(header) {
          const allHeaders = document.querySelectorAll('.accordion-header');
          const allBodies = document.querySelectorAll('.accordion-body');
      
          // Check if currently collapsed
          const isCollapsed = header.classList.contains('collapsed');
      
          if (isCollapsed) {
          // EXPAND ALL
          allHeaders.forEach(h => h.classList.remove('collapsed'));
          allBodies.forEach(b => b.classList.remove('collapsed'));
          } else {
          // COLLAPSE ALL
          allHeaders.forEach(h => h.classList.add('collapsed'));
          allBodies.forEach(b => b.classList.add('collapsed'));
          }
      }
      function toggleAccordionDispenser(header) {
          const allHeaders = document.querySelectorAll('.accordion-header1');
          const allBodies = document.querySelectorAll('.accordion-body1');
      
          // Check if currently collapsed
          const isCollapsed = header.classList.contains('collapsed');
      
          if (isCollapsed) {
              // EXPAND ALL
              allHeaders.forEach(h => h.classList.remove('collapsed'));
              allBodies.forEach(b => b.classList.remove('collapsed'));
          } else {
              // COLLAPSE ALL
              allHeaders.forEach(h => h.classList.add('collapsed'));
              allBodies.forEach(b => b.classList.add('collapsed'));
          }
      }
          document.addEventListener('DOMContentLoaded', function () {
      
          const currentTarget   = {!IF(ISBLANK(currentTarget), 0, currentTarget)};
          const currentSale     = {!IF(ISBLANK(currentSale), 0, currentSale)};
          const previousTarget  = {!IF(ISBLANK(previousTarget), 0, previousTarget)};
          const previousSale    = {!IF(ISBLANK(previousSale), 0, previousSale)};
      
          const ctx = document.getElementById('performanceChart').getContext('2d');
      
          new Chart(ctx, {
              type: 'bar',
              data: {
                  labels: ['Current Month', 'Previous Month'],
                  datasets: [
                      {
                          label: 'Target',
                          data: [currentTarget, previousTarget],
                          backgroundColor: '#4c84ff',
                          barPercentage: 0.5,        // 🔽 reduces bar width
      categoryPercentage: 0.6
                      },
                      {
                          label: 'Sale',
                          data: [currentSale, previousSale],
                          backgroundColor: '#10d48e',
                          barPercentage: 0.5,        // 🔽 reduces bar width
      categoryPercentage: 0.6
                      }
                  ]
              },
              options: {
                  responsive: true,
                  plugins: {
                      legend: {
                          position: 'bottom'
                      },
                      title: {
                          display: false,
                      }
                  },
                  scales: {
                      y: {
                          beginAtZero: true
                      },
                       x: {
      grid: {
      display: false
      }
      }
                  }
              }
          });
      
      });
   </script>
