<apex:page controller="BulkUploadJointPdfController" renderAs="pdf">
    <html>
    <head>
        <style>
            .underline-field {
                display: inline-block;
                border-bottom: 1px solid black;
                width: 300px;
                text-align: left;
                height: 18px;
                padding: 2px 5px;
                vertical-align: bottom;
                font-family: 'Times New Roman';
            }
            .page-break {
                page-break-after: always;
            }
        </style>
    </head>
    <body>
        <apex:repeat value="{!tickets}" var="work">
            <!-- Header -->
            <table width="100%">
                <tr>
                    <td style="width: 25%;">
                        <img src="{!$Resource.MGL_Logo}" style="height: 70px;" />
                    </td>
                    <td style="width: 50%; text-align: center;">
                        <div style="font-family: 'Times New Roman'; font-size: 17px;">MAHANAGAR GAS LIMITED</div>
                        <div style="font-family: 'Times New Roman'; font-size: 15px;">JOINT TICKET</div>
                    </td>
                    <td style="width: 25%;"></td>
                </tr>
            </table>

            <br/>

            <!-- Retail Details -->
            <div style="font-family: 'Times New Roman'; font-size: 14px;">

                <!-- Row 1 -->
                <div style="margin-bottom: 10px;">
                    <span>NAME OF CNG RETAIL OUTLET</span>
                    <span style="display: inline-block;
            border-bottom: 1px solid black;
            width: 240px;
            text-align: left;
            height: 18px;
            padding: 2px 5px;
            vertical-align: bottom;
            font-family: 'Times New Roman';font-weight: 600 !important;">{!work.ticket.Account.Name}</span>
                    <span>LOCATION</span>
                    <span  style="display: inline-block;
            border-bottom: 1px solid black;
            width: 150px;
            text-align: left;
            height: 18px;
            padding: 2px 5px;
            vertical-align: bottom;
            font-family: 'Times New Roman';font-weight: 600 !important;">{!work.ticket.Account.Location__c}</span>
                </div>

                <!-- Row 2 -->
                <div style="margin-bottom: 10px;">
                    <span>NAME OF REPRESENTATIVE COMPANY</span>
                    <span style="display: inline-block;
            border-bottom: 1px solid black;
            width: 428px;
            text-align: left;
            height: 18px;
            padding: 2px 5px;
            vertical-align: bottom;
            font-family: 'Times New Roman';font-weight: 600 !important;">{!work.ticket.Account.Representative_Company__c}</span>
                </div>

                <!-- Row 3 -->
                <div style="margin-bottom: 4px;">
                    <span>Sale for the period</span>
                    <span style="display: inline-block;
            border-bottom: 1px solid black;
            width: 150px;
            text-align: left;
            height: 18px;
            padding: 2px 5px;
            vertical-align: bottom;
            font-family: 'Times New Roman';font-weight: 600 !important;">{!work.formattedFromDate}</span>
                    <span style="margin-left: 10px;">to</span>
                    <span style="display: inline-block;
            border-bottom: 1px solid black;
            width: 150px;
            text-align: left;
            height: 18px;
            padding: 2px 5px;
            vertical-align: bottom;
            font-family: 'Times New Roman';font-weight: 600 !important;">{!work.formattedToDate}</span>
                </div>

                <!-- Row 4 -->
                <div>
                    <span>(Starting at 0600 hrs and ending at 0600 hrs)</span>
                </div>

            </div>

            <br/>

            <!-- Dispenser Table -->
            <apex:outputPanel rendered="{!work.useDualColumn}">
                <table width="100%" border="1" cellpadding="4" cellspacing="0" style="border-collapse: collapse; font-family: 'Times New Roman'; font-size: 13px; text-align: center;">
                    <tr>
                        <th colspan="8"><b>Dispenser wise break-up of Sale</b></th>
                    </tr>
                    <tr>
                        <th>Disp. Pts.</th>
                        <th>Opening Reading</th>
                        <th>Closing Reading</th>
                        <th>Difference</th>
                        <th>Disp. Pts.</th>
                        <th>Opening Reading</th>
                        <th>Closing Reading</th>
                        <th>Difference</th>
                    </tr>
                    <apex:repeat value="{!ROW_COUNT}" var="i">
                        <tr>
                            <td style="min-height:15px">{!work.dispenserListLeft[i-1].pointName}</td>
                            <td style="min-height:15px">{!work.dispenserListLeft[i-1].opening}</td>
                            <td style="min-height:15px">{!work.dispenserListLeft[i-1].closing}</td>
                            <td style="min-height:15px">{!work.dispenserListLeft[i-1].difference}</td>

                            <td style="min-height:15px">{!work.dispenserListRight[i-1].pointName}</td>
                            <td style="min-height:15px">{!work.dispenserListRight[i-1].opening}</td>
                            <td style="min-height:15px">{!work.dispenserListRight[i-1].closing}</td>
                            <td style="min-height:15px">{!work.dispenserListRight[i-1].difference}</td>
                        </tr>
                    </apex:repeat>
                    <tr>
                        <td colspan="8" style="text-align: left;"><b>Total Dispensing Point Sale (a) (Kg) = {!work.totalSale}</b></td>
                    </tr>
                </table>
            </apex:outputPanel>

            <br/>

            <!-- Reading Table -->
            <table width="100%" border="1" cellpadding="4" cellspacing="0" style="font-family: 'Times New Roman'; font-size: 13px; text-align: center; border-collapse: collapse;">
                <tr>
                    <td>Reading of</td>
                    <td>Total Quantity (Kg)</td>
                    <td>Reasons</td>
                </tr>
                <tr>
                    <td>Calibration</td>
                    <td>{!work.totalCalibration}</td>
                    <td>&nbsp;</td>
                </tr>
                <tr>
                    <td>Jumping</td>
                    <td>{!work.totalJumping}</td>
                    <td>&nbsp;</td>
                </tr>
                <tr>
                    <td>Others</td>
                    <td>{!work.totalOthers}</td>
                    <td>&nbsp;</td>
                </tr>
                <tr>
                    <td>Total Reading (b) (Kg)</td>
                    <td>{!work.totalReadingJump}</td>
                    <td>&nbsp;</td>
                </tr>
            </table>

            <br/>
            <div style="font-family: 'Times New Roman'; font-size: 13px; text-align: center;">
                Total Gas Consumption C = (a - b) = <span style="font-weight: 600 !important;">{!work.overallQuantity}</span> Kg
            </div>

            <br/>

            <!-- Final Summary -->
            <table width="100%" border="1" cellpadding="4" cellspacing="0" style="font-family: 'Times New Roman'; font-size: 13px; text-align: center; border-collapse: collapse;">
                <tr>
                    <td rowspan="2">Name of Consumption</td>
                    <td rowspan="2">Qty in Kg</td>
                    <td colspan="3">Authorized Signatory</td>
                </tr>
                <tr>
                    <td>Retail Outlet</td>
                    <td>MGL</td>
                    <td>OMC</td>
                </tr>
                <tr>
                    <!-- <td>Total Sale (C)</td>
                    <td style="padding:10px">{!work.overallQuantity}</td>
                    <td style="width: 80px; height: 80px;">
                        <img src="{!work.fileDownloadUrl}" style="width: 100%; height: 100%;"/>
                    </td>
                    <td style="padding:10px">
                        <div>{!work.ticket.Assigned_Meter_Reader__r.RelatedRecord.Name}-{!work.checkOutDate} {!work.checkOutTime}</div>
                        <div>Approved By <br/>{!work.ticket.Approvar_User__r.Name}-{!work.approvarDate} {!work.approvarTime}</div></td>
                    <td style="padding:40px"></td> -->

                    <td>Total Sale (C)</td>
                    <td style="padding:10px;font-weight: 600 !important;">{!work.overallQuantity}</td>
                    <td style="width: 250px; height: 140px;">
                        <img src="{!work.fileDownloadUrl}" style="width: 100%; height: 100%;" />
                    </td>
                    <td>
                        <div>{!work.ticket.Assigned_Meter_Reader__r.RelatedRecord.Name}<br/>{!work.checkOutDate} {!work.checkOutTime}</div>
                        <div>Approved By <br/>{!work.ticket.Approvar_User__r.Name}<br/>{!work.approvarDate} {!work.approvarTime}</div>
                    </td>
                    <td style="padding:40px;"></td>
                    <!-- <td style="padding:10px">{!overallQuantity}</td> -->
                    <!-- <td style="width: 80px; height: 80px;">
                        <img src="{!fileDownloadUrl}" style="width: 100%; height: 100%;" />
                    </td> -->
                    <!-- <td style="padding:10px">
                        <div>{!ticket.Assigned_Meter_Reader__r.RelatedRecord.Name}-{!checkOutDate} {!checkOutTime}</div>
                        <div>Approved By <br/>{!ticket.Approvar_User__r.Name}-{!approvarDate} {!approvarTime}</div></td>
                    <td style="padding:40px;"></td> -->
                </tr>
            </table>

            <div style="page-break-after: always;"></div>
        </apex:repeat>
    </body>
    </html>
</apex:page>