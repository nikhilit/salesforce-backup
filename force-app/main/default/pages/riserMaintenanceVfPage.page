<apex:page controller="WorkOrderInspectionCtrl" renderAs="pdf">
    <html>
        <head></head>
        <body style="font-size:12px; font-family:Arial, sans-serif;">
            
            <div style="text-align:center; font-weight:bold; font-size:14px;">
                <h2 style="text-align: center; text-decoration: underline; font-size:16px; margin:2px;">MAHANAGAR GAS LIMITED</h2>
                <p style="margin:2px; font-size:13px;"><b>QUALITY SYSTEM RECORD</b></p>
            </div>
            <br/>
            <!-- Header Info -->
            <table style="width:100%; border-collapse:collapse; border:1px solid black; font-size:11px;">
                <tr>
                    <td style="padding:4px; font-weight:bold;">RECORD NO: PNG RE 024</td>
                    <td style="padding:4px; font-weight:bold;align:right">ISSUE NO: 5</td>
                </tr>
                <tr>
                    <td style="padding:4px; font-weight:bold;">TITLE: GI RISER TESTING REPORT</td>
                    <td style="padding:4px; font-weight:bold;align:right">ISSUE DATE: 23-04-2025</td>
                </tr>
                <tr>
                    <td style="padding:4px;"></td>
                    <td style="padding:4px; font-weight:bold;align:right">PAGE: 1 of 1</td>
                </tr>
            </table>

            <!-- Center Title -->
            <div style="text-align:center; font-weight:bold; border-top:1px solid black; margin-top:6px; padding:4px; font-size:13px;">
                GI RISER TESTING REPORT
            </div>

            <!-- Client & Contractor Info -->
            <table style="width:100%; border-collapse:collapse; border:1px solid black; margin-top:6px; font-size:11px;">
                <tr>
                    <td style="border:1px solid black; padding:4px; font-weight:bold;">
                        CLIENT : <span style="font-weight:normal;">MAHANAGAR GAS LTD.</span>
                    </td>
                    <td style="border:1px solid black; padding:4px; font-weight:bold;">
                        DRS No : <span style="font-weight:normal;">{!workOrder.DRS_No__c}</span>
                    </td>
                </tr>
                <tr>
                    <td style="border:1px solid black; padding:4px; font-weight:bold;">
                        CONTRACTOR : <span style="font-weight:normal;">{!workOrder.Owner.Name}</span>
                    </td>
                    <td style="border:1px solid black; padding:4px; font-weight:bold;">
                        CO Number : <span style="font-weight:normal;">{!workOrder.Owner.Name}</span>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" style="border:1px solid black; padding:4px; font-weight:bold;">
                        BUILDING/LOCATION : <span style="font-weight:normal;">{!workOrder.Location__c}</span>
                    </td>
                </tr>
            </table>
            
            <br/>
            <b style="font-size:12px;">INSTRUMENT CALIBRATION DETAILS: (as applicable)</b>
            <table style="width:100%; border-collapse:collapse; margin-top:6px; font-size:11px;">
    <tr>
        <th style="border:1px solid black; padding:4px; width:50%;">Instrument Type &amp; Range</th>
        <th style="border:1px solid black; padding:4px; width:50%;">Calibration Date</th>
    </tr>
    <tr>
        <td style="border:1px solid black; padding:4px;">{!workOrder.RM_Instrument_Type_Range__c}</td>
        <td style="border:1px solid black; padding:4px;">{!workOrder.RM_Calibration_Date__c}</td>
    </tr>
    <tr>
        <th style="border:1px solid black; padding:4px; width:50%;">Calibration Certificate No.</th>
        <th style="border:1px solid black; padding:4px; width:50%;">Calibration Due Date</th>
    </tr>
    <tr>
        <td style="border:1px solid black; padding:4px;">{!workOrder.RM_Calibration_Certificate_No__c}</td>
        <td style="border:1px solid black; padding:4px;">{!workOrder.RM_Calibration_Due_Date__c}</td>
    </tr>
</table>

            
            <p style="font-size:12px; margin-top:6px;"><b>OPERATING PRESSURE:</b> 100 mbar</p>
            
            <b style="font-size:12px;">INSPECTION DETAILS FOR RISERS:</b>
            <table style="width:100%; border-collapse:collapse; margin-top:6px; font-size:11px;">
                <tr>
                    <th style="border:1px solid #000; padding:4px;">Riser No</th>
                    <apex:repeat value="{!risers}" var="r">
                        <td style="border:1px solid #000; width:12%; padding:4px;">{!r.riserNo}</td>
                    </apex:repeat>
                </tr>
                <tr>
                    <th style="border:1px solid #000; padding:4px;">Date</th>
                    <apex:repeat value="{!risers}" var="r">
                        <td style="border:1px solid #000; width:12%; padding:4px;">
                            <apex:outputText value="{0,date,dd-MM-yyyy}" rendered="{!NOT(ISNULL(r.dateVal))}">
                                <apex:param value="{!r.dateVal}" />
                            </apex:outputText>
                        </td>
                    </apex:repeat>
                </tr>
                <tr>
                    <th style="border:1px solid #000; padding:4px;">Test Pressure</th>
                    <apex:repeat value="{!risers}" var="r">
                        <td style="border:1px solid #000; width:12%; padding:4px;">{!r.testPressure}</td>
                    </apex:repeat>
                </tr>
                <tr>
                    <th style="border:1px solid #000; padding:4px;">Duration</th>
                    <apex:repeat value="{!risers}" var="r">
                        <td style="border:1px solid #000; width:12%; padding:4px;">{!r.duration}</td>
                    </apex:repeat>
                </tr>
                <tr>
                    <th style="border:1px solid #000; padding:4px;">No. of leakages</th>
                    <apex:repeat value="{!risers}" var="r">
                        <td style="border:1px solid #000; width:12%; padding:4px;">{!r.noOfLeakages}</td>
                    </apex:repeat>
                </tr>
                <tr>
                    <th style="border:1px solid #000; padding:4px;">Result (OK/Not OK)</th>
                    <apex:repeat value="{!risers}" var="r">
                        <td style="border:1px solid #000; width:12%; padding:4px;">{!r.result}</td>
                    </apex:repeat>
                </tr>
                <tr>
                    <th style="border:1px solid #000; padding:4px;">No. of Connections</th>
                    <apex:repeat value="{!risers}" var="r">
                        <td style="border:1px solid #000; width:12%; padding:4px;">{!r.noOfConnections}</td>
                    </apex:repeat>
                </tr>
                <tr>
                    <th style="border:1px solid #000; padding:4px;">Remark</th>
                    <apex:repeat value="{!risers}" var="r">
                        <td style="border:1px solid #000; width:12%; padding:4px;">{!r.remark}</td>
                    </apex:repeat>
                </tr>
            </table>

            <br/>
            <b style="font-size:12px;">Leakage detection and rectification details:</b>
            <table style="width:100%; border-collapse:collapse; margin-top:6px; font-size:11px;">
                <tr>
                    <th style="border:1px solid black; padding:4px;">Leak number</th>
                    <th style="border:1px solid black; padding:4px;">Riser number</th>
                    <th style="border:1px solid black; padding:4px;">Leak location</th>
                    <th style="border:1px solid black; padding:4px;">Leak nature</th>
                    <th style="border:1px solid black; padding:4px;">Material used</th>
                </tr>
                <apex:repeat value="{!risers}" var="item">
                    <tr>
                        <td style="border:1px solid black; padding:4px;height:23px">{!item.noOfLeakages}</td>
                        <td style="border:1px solid black; padding:4px;height:23px">{!item.riserNo}</td>
                        <td style="border:1px solid black; padding:4px;height:23px">{!item.riserNo}</td>
                        <td style="border:1px solid black; padding:4px;height:23px"></td>
                        <td style="border:1px solid black; padding:4px;height:23px"></td>
                    </tr>
                </apex:repeat>
            </table>
            
            <br/><br/>
           <p style="font-size:12px; margin-bottom:8px;">I certify that riser is safe to charge the gas.</p>

<!-- Witnessed / Contractor Section -->
<table style="width:100%; font-size:11px; border:none; margin-top:5px;">
    <tr>
        <td style="width:50%; vertical-align:top; padding:5px;">
            <b>Witnessed by</b><br/>
            <b>MGL TPE</b><br/>
            Name: __________<br/>
            Signature: __________
        </td>
        <td style="width:50%; vertical-align:top; padding:5px;">
            <b>Contractor's Supervisor:</b><br/>
            Name: __________<br/>
            Signature: __________
        </td>
    </tr>
</table>

<hr style="border:1px solid black; margin:8px 0;"/>

<!-- Approved / Issued Section -->
<table style="width:100%; font-size:11px; border:none; margin-top:5px;">
    <tr>
        <td style="width:50%; vertical-align:top; padding:5px;">
            <b>Approved by:</b><br/>
            <span style="font-weight:bold;">HOD (PNG Maint. &amp; Online Const.)</span>
        </td>
        <td style="width:50%; vertical-align:top; padding:5px;">
            <b>Issued by:</b><br/>
            <span style="font-weight:bold;">ISO REPRESENTATIVE (O&amp;M)</span>
        </td>
    </tr>
</table>

        </body>
    </html>
</apex:page>