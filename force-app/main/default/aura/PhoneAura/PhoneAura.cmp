<aura:component 
    implements="lightning:backgroundUtilityItem,flexipage:availableForAllPageTypes,lightning:utilityItem,force:appHostable"
    access="global"
    controller="InboundCallController"> <!-- Apex class -->

    <!-- Attributes
    <aura:attribute name="CANumber" type="String" />-->
    <aura:attribute name="phone" type="String" />
    <aura:attribute name="agentName" type="String" />
    <aura:attribute name="recordId" type="String" />
<aura:attribute name="currentUserAgentId" type="String" />
    <!-- Handlers -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <!-- Platform Event API -->
    <lightning:empApi aura:id="empApi" />
    
    <!-- Required for navigation to custom LWC tab -->
    <lightning:navigation aura:id="navService" />

    <!-- Optional: Utility bar API -->
    <lightning:utilityBarAPI aura:id="utilitybar" />

</aura:component>